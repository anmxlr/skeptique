# Copy to .env and fill in every key; `pnpm env:check` fails on any missing value.
# Never commit .env. Sponsor-specific values are confirmed by the spike notes in spec/notes/.

# --- Hedera testnet (spec/01 "Money on Hedera"; confirm values in spec/notes/hedera-x402.md) ---
# EVM JSON-RPC endpoint for Hedera testnet
HEDERA_RPC_URL=
# EVM chain id of Hedera testnet
HEDERA_CHAIN_ID=
# Mirror node REST base URL (HCS reads, tx lookups)
HEDERA_MIRROR_NODE_URL=
# Deploys the mechanism contracts
DEPLOYER_ACCOUNT_ID=
DEPLOYER_PRIVATE_KEY=
# Public deployment manifest used by API, critics and relayer (default contracts/deployments/hedera-testnet.json)
DEPLOYMENT_PATH=
# Set true for the documented 90s commit / 45s reveal demo windows
HEDERA_DEMO_WINDOWS=false
# Lists demo services and receives x402 payments for them
SELLER_ACCOUNT_ID=
SELLER_PRIVATE_KEY=
# Buyer agent wallet (pays services via x402)
BUYER_ACCOUNT_ID=
BUYER_PRIVATE_KEY=
# Pool of critic agent wallets, comma-separated, same order in both lists
CRITIC_ACCOUNT_IDS=
CRITIC_PRIVATE_KEYS=
# Relayer's Hedera account: posts to the HCS audit topic
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# HCS topic used as the audit log (round_finalized, critic_slashed, agent_spend)
HCS_TOPIC_ID=

# --- x402 (spec/03 "x402 client"; facilitator chosen in spec/notes/hedera-x402.md) ---
# Facilitator base URL; switchable to a fallback facilitator without code changes
X402_FACILITATOR_URL=

# --- World ID 4.0 relying party from developer.world.org (spec/notes/world.md) ---
# Public: app_... id passed to IDKit on the client
WORLD_APP_ID=
# Public: rp_... id, used in the client rp_context and the verify URL path
WORLD_RP_ID=
# Secret, server-side only: signs each IDKit request (rp_context)
WORLD_SIGNING_KEY=
# "staging" accepts World simulator proofs (the event's mocked proofs); "production" only real World App proofs
WORLD_ENVIRONMENT=staging
# Signs critic vouchers after server-side World validation (spec/01 default 3)
ATTESTOR_PRIVATE_KEY=

# --- ENS on Sepolia (spec/notes/ens.md) ---
SEPOLIA_RPC_URL=
# Relayer key holding the ENS score-writer role
SEPOLIA_RELAYER_PRIVATE_KEY=
# Operator key that owns the ENS parent name, subname registries and resolvers
ENS_OPERATOR_PRIVATE_KEY=
# Parent name the service and critic subnames live under
ENS_PARENT_NAME=

# --- LLM (critic probes and judge, buyer explanation) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- App ---
API_PORT=
# Public API base URL the web app calls
NEXT_PUBLIC_API_URL=
# SQLite file used by apps/api
DATABASE_PATH=
