{
  "name": "skeptique",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "lab:api": "pnpm --filter @skeptique/scripts exec tsx testing-lab.ts",
    "lab:web": "SKEPTIQUE_LAB_ENABLED=1 pnpm --filter @skeptique/web exec next dev --hostname 127.0.0.1 --port 3100",
    "lab:preview": "SKEPTIQUE_LAB_ENABLED=1 pnpm --filter @skeptique/web exec next start --hostname 127.0.0.1 --port 3100",
    "lab:test": "pnpm --filter @skeptique/scripts exec vitest run demo/testing-lab.test.ts && pnpm --filter @skeptique/web exec playwright test --config playwright.lab.config.ts",
    "prepare": "node scripts/install-hooks.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "env:check": "node scripts/env-check.mjs",
    "seed": "pnpm --filter @skeptique/scripts exec tsx seed.ts",
    "drills": "pnpm --filter @skeptique/scripts exec tsx drills.ts",
    "settle:local": "pnpm --filter @skeptique/contracts settle:local",
    "ai-usage": "node scripts/ai-usage.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@skeptique/harness": "workspace:^",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
